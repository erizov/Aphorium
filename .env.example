# Aphorium Configuration
# Copy this file to .env and update with your values

# Database Configuration
# Format: postgresql://username:password@host:port/database_name
# Example: postgresql://postgres:postgres@localhost:5432/aphorium
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aphorium

# Logging Configuration
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (optional, leave empty for console only)
# Will create logs/ directory if specified
LOG_FILE=logs/aphorium.log

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000

# WikiQuote Scraping Configuration
WIKIQUOTE_RU_BASE_URL=https://ru.wikiquote.org
WIKIQUOTE_EN_BASE_URL=https://en.wikiquote.org

# Delay between scraping requests (in seconds)
# Increase if you encounter rate limiting
# Recommended: 1.0-2.0 seconds
SCRAPE_DELAY=1.0

# News LLM generation
# LLM_PROVIDER=auto uses OpenAI when OPENAI_API_KEY is set,
# otherwise it uses the local OpenAI-compatible endpoint below.
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=llama3.2
LOCAL_LLM_API_KEY=ollama
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=512

# News ingestion
NEWS_API_KEY=
RSS_FEEDS=[]
NEWS_SCRAPE_ALLOWED_HOSTS=[]
NEWS_PERIODIC_FETCH_ENABLED=false
